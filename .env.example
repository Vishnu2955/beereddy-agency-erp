# Root Environment Configuration Template for Beereddy Agency ERP

NODE_ENV=production
PORT=5000

# MongoDB Atlas Database Connection URI
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/beereddy_erp?retryWrites=true&w=majority

# Security JWT Secret Key
JWT_SECRET=your_super_secret_production_jwt_key_here

# Nodemailer SMTP Email Credentials
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_app_password

# Admin WhatsApp Alert Receiver Number
ADMIN_WHATSAPP_NUMBER=916302039120
